{
  "name": "@kc/game-rules",
  "version": "0.1.0",
  "private": true,
  "description": "Pure game rules for Knights and Castles — reusable on client and server",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./storage": {
      "types": "./dist/save-storage.d.ts",
      "import": "./dist/save-storage.js",
      "default": "./dist/save-storage.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "arena": "vitest run --config vitest.arena.config.ts",
    "solve": "tsc && node scripts/solve.mjs"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
