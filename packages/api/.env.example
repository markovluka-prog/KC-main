# Copy to .env.local and fill in real values. Gitignored.
#
# Generate a fresh Ed25519 JWK for local dev:
#   node infra/scripts/gen-jwt-key.mjs > /tmp/k.json
#   # paste into JWT_PRIVATE_KEY_JWK below, then delete /tmp/k.json.

NODE_ENV=development
LOG_LEVEL=debug
HOST=0.0.0.0
PORT=8080

DATABASE_URL=postgres://kc:kc@localhost:5432/kc_dev

JWT_PRIVATE_KEY_JWK=<paste-private-jwk-json-here>

# Production-only credentials. Locally these are unused when AUTH_MODE=dev-bypass.
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
GOOGLE_OIDC_REDIRECT_URI=https://kc.agatha-mistery.com/api/auth/google/callback

CORS_ORIGINS=http://localhost:5173

# dev-bypass | production
AUTH_MODE=dev-bypass
DEV_BYPASS_USER_ID=00000000-0000-0000-0000-000000000001

POSTMARK_API_TOKEN=
POSTMARK_FROM_EMAIL=no-reply@kc.agatha-mistery.com

# Ollama — local LLM, no API key, no limits (primary)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Groq — free hosted model (https://console.groq.com), the first hosted provider
# tried after Ollama and the recommended one. OpenAI-compatible and fast enough
# to run inside a turn: measured ~250 ms per request, 1000 requests/day, with no
# enforced gap between consecutive requests. Free key, no card.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# ApiFreeLLM — free hosted model (https://apifreellm.com), tried after Groq.
# NOTE ON THE FREE TIER: it rate-limits to roughly one request per 10-20 s per
# key and answers 429 with a `retryAfter`. A game turn cannot wait that long, so
# APIFREELLM_MAX_WAIT_MS caps how long we honour it; past that the request is
# abandoned and the server's local MCTS search plans the turn instead. Raising
# the cap makes turns slower and more erratic, not smarter — the local search is
# already a strong player. Leave the key blank to skip this provider entirely.
APIFREELLM_API_KEY=
APIFREELLM_BASE_URL=https://apifreellm.com
APIFREELLM_MAX_WAIT_MS=8000

# OpenRouter — cloud fallback if the above are unavailable
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
