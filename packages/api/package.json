{
  "name": "@kc/api",
  "version": "0.1.0",
  "private": true,
  "description": "Knights and Castles — backend API (Fastify, Postgres, OIDC auth)",
  "type": "module",
  "main": "./src/main.ts",
  "scripts": {
    "dev": "env $(grep -v '^#' .env | grep -v '^$' | xargs) tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "drizzle-kit migrate",
    "migrate:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/rate-limit": "^10.2.0",
    "@fastify/websocket": "^11.0.0",
    "@kc/game-rules": "workspace:*",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.0.0",
    "jose": "^5.9.0",
    "openai": "^6.39.0",
    "openid-client": "^6.1.0",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
