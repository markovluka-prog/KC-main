{
  "name": "@kc/web",
  "version": "0.1.0",
  "private": true,
  "description": "Knights and Castles — web client",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "bench": "vitest run --config vitest.bench.config.ts",
    "gauntlet": "vitest run --config vitest.gauntlet.config.ts",
    "nn:selfplay": "vitest run --config vitest.nn-selfplay.config.ts",
    "nn:bench": "vitest run --config vitest.nn-bench.config.ts",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@kc/game-rules": "workspace:*",
    "@supabase/supabase-js": "^2.106.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "happy-dom": "^20.9.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  }
}
